# HopeMind — Desenvolvimento Local (Padrão Prottus)
# Copie este arquivo para `.env` e `backend/.env`

# Banco: PostgreSQL no Supabase (gratuito, online)
# Pegue os valores em: painel do projeto → Connect → ORMs → Prisma.
# Troque [SENHA] pela senha do banco. O "schema=hopemind" deixa as tabelas do HopeMind separadas,
# assim o mesmo projeto do Supabase pode guardar o banco de outras aplicações em outros schemas.
#
# Usado pela API (pooler de transações, porta 6543):
DATABASE_URL="postgresql://postgres.[REF-DO-PROJETO]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=hopemind"
# Usado pelo `prisma db push` (conexão de sessão, porta 5432):
DIRECT_URL="postgresql://postgres.[REF-DO-PROJETO]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=hopemind"

# API NestJS
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# JWT (access + refresh) — Cookies httpOnly
JWT_ACCESS_SECRET=hopemind-access-secret-key-2026-prottus
JWT_REFRESH_SECRET=hopemind-refresh-secret-key-2026-prottus
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Boot & Seed
SEED_DEMO_USER_ON_BOOT=true

# Frontend
VITE_API_URL=http://localhost:3000/api

# HopeMind — Desenvolvimento Local (Padrão Prottus)
# Copie este arquivo para `.env` e `backend/.env`

# MariaDB / MySQL Local (Porta 3306)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/hopemind"

# API NestJS
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# JWT (access + refresh) — Cookies httpOnly
JWT_ACCESS_SECRET=hopemind-access-secret-key-2026-prottus
JWT_REFRESH_SECRET=hopemind-refresh-secret-key-2026-prottus
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Boot & Seed
SEED_DEMO_USER_ON_BOOT=true

# Frontend
VITE_API_URL=http://localhost:3000/api

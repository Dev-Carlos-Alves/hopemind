// HopeMind - Prisma Schema (MariaDB / MySQL)
// Enterprise Standard: Modelo Prottus

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  PATIENT
  PSYCHOLOGIST
  ADMIN
}

enum QuestionnaireAudience {
  PATIENT
  PSYCHOLOGIST
}

enum SafetyLevel {
  NONE
  WANTS_TALK
  ELEVATED
  IMMEDIATE
}

enum SafetyAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  cpf          String   @unique @db.VarChar(20)
  phone        String   @db.VarChar(50)
  birthDate    DateTime @map("birth_date") @db.Date
  gender       String   @db.VarChar(50)
  userType     UserType @default(PATIENT) @map("user_type")
  isActive     Boolean  @default(true) @map("is_active")

  // Endereço resolvido pelo CEP (ViaCEP/BrasilAPI + OpenStreetMap). Para o psicólogo é o
  // consultório; para o paciente, só serve para calcular a distância no match.
  cep           String?  @db.VarChar(9)
  street        String?  @db.VarChar(255)
  addressNumber String?  @map("address_number") @db.VarChar(20)
  neighborhood  String?  @db.VarChar(120)
  city          String?  @db.VarChar(120)
  state         String?  @db.VarChar(2)
  latitude      Float?
  longitude     Float?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient           Patient?
  psychologist      Psychologist?
  auditLogs         AuditLog[]
  triageSubmissions TriageSubmission[]

  @@map("users")
}

model Patient {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  mainComplaint String?  @map("main_complaint") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  safetyAlerts SafetyAlert[]
  matchRuns    MatchRun[]

  @@map("patients")
}

model Psychologist {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  crp                 String   @unique @db.VarChar(50)
  contactLink         String?  @map("contact_link") @db.VarChar(500)
  specialty           String   @db.VarChar(255)
  therapeuticApproach String   @map("therapeutic_approach") @db.VarChar(255)
  biography           String?  @db.Text
  sessionFee          Decimal  @default(0.00) @map("session_fee") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("psychologists")
}

// Questionnaire answers (patient P01–P30 or psychologist S01–S21). The questions live in
// backend/src/triage/questionnaire and are versioned with the code; each submission records
// which version was answered so results stay auditable. The latest row is the current profile.
model TriageSubmission {
  id                   Int                   @id @default(autoincrement())
  userId               Int                   @map("user_id")
  audience             QuestionnaireAudience
  questionnaireVersion String                @map("questionnaire_version") @db.VarChar(40)
  answers              Json
  safetyLevel          SafetyLevel           @default(NONE) @map("safety_level")
  createdAt            DateTime              @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  safetyAlert SafetyAlert?
  matchRuns   MatchRun[]

  @@index([userId, createdAt])
  @@map("triage_submissions")
}

// Risk answers open a follow-up for the clinical team; they never affect the ranking.
model SafetyAlert {
  id           Int               @id @default(autoincrement())
  patientId    Int               @map("patient_id")
  submissionId Int               @unique @map("submission_id")
  level        SafetyLevel
  status       SafetyAlertStatus @default(OPEN)
  createdAt    DateTime          @default(now()) @map("created_at")
  resolvedAt   DateTime?         @map("resolved_at")

  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  submission TriageSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("safety_alerts")
}

// Snapshot of every recommendation served, with algorithm + questionnaire versions (audit trail).
model MatchRun {
  id                   Int      @id @default(autoincrement())
  patientId            Int      @map("patient_id")
  submissionId         Int      @map("submission_id")
  algorithmVersion     String   @map("algorithm_version") @db.VarChar(40)
  questionnaireVersion String   @map("questionnaire_version") @db.VarChar(40)
  results              Json
  createdAt            DateTime @default(now()) @map("created_at")

  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  submission TriageSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("match_runs")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  psychologistId  Int               @map("psychologist_id")
  patientId       Int               @map("patient_id")
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now()) @map("created_at")

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityName String   @map("entity_name") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  action     String   @db.VarChar(50)
  payload    Json?
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
